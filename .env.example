# Argus Local Development Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration (optional - required for PWA and cloud sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Meta API Configuration (optional - enables AI diagnosis)
META_API_KEY=your-meta-api-key
META_BASE_URL=https://api.meta.example.com/v1
META_MODEL=meta-llama-3-70b

# OpenCode Configuration
OPENCODE_BINARY=opencode

# Go Service Configuration
AGENT_MANAGER_PORT=8080
AGENT_MANAGER_DB=argus.db